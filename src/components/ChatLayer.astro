---
import HeroOrb from './HeroOrb.astro';
const BASE = import.meta.env.BASE_URL;
---

<a
  href={`${BASE}chat`}
  data-chat-dock
  aria-label="和 AI 聊"
  class="chat-dock fixed bottom-6 right-6 z-30 w-[48px] h-[48px] flex items-center justify-center cursor-pointer transition-transform duration-300 hover:scale-110 dock-orb-halo"
  onmouseenter="window.__MOYUANHUA_orbState='typing'"
  onmouseleave="window.__MOYUANHUA_orbState='idle'"
  onfocus="window.__MOYUANHUA_orbState='typing'"
  onblur="window.__MOYUANHUA_orbState='idle'"
>
  <HeroOrb size={48} />
</a>

<style is:global>
  /* CSS-only breathing halo for the dock orb. The orb itself is
     a canvas (HeroOrb) with its own internal animation; this halo
     is a static glow that pulses, signaling 'this AI is alive'
     without needing canvas frame-rate. Honors reduced-motion. */
  .dock-orb-halo {
    border-radius: 9999px;
    animation: dock-orb-breathe 2.4s ease-in-out infinite;
  }
  @keyframes dock-orb-breathe {
    0%, 100% { box-shadow: 0 0 0 0 var(--color-accent-soft); }
    50%      { box-shadow: 0 0 0 6px var(--color-accent-soft); }
  }
  @media (prefers-reduced-motion: reduce) {
    .dock-orb-halo { animation: none; box-shadow: 0 0 0 3px var(--color-accent-soft); }
  }
</style>
