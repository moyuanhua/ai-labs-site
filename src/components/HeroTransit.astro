---
/**
 * HeroTransit.astro — Demo → Production narrative hero centerpiece.
 *
 * Three panels, one story:
 *   [DEMO] terminal-style code snippet (left)
 *   [TRANSIT] AI orb as the converter, with flowing dashed arrows (center)
 *   [PRODUCTION] live status dashboard with mono metrics (right)
 *
 * Replaces the old "left text / right orb" layout. The orb is now in
 * the middle of a horizontal pipeline — its meaning becomes "this is
 * the converter from demo to production", not "this is decoration".
 *
 * Constraints (per AGENTS.md):
 *   - Zero new colors: every fill/border/text uses existing CSS vars
 *     (--color-dark, --color-surface, --color-border, --color-accent, etc.)
 *   - Geist Mono for all terminal text + metric values; Geist Sans for
 *     section labels.
 *   - Shape lock: rounded-[6px] for the two outer panels; the orb
 *     container keeps its existing rounded-full (documented exception).
 *   - Static placeholder metrics. The user replaces them with real
 *     numbers from their work when ready.
 *   - Pure CSS for arrows; no Canvas here (HeroOrb is reused).
 */
import HeroOrb from './HeroOrb.astro';
---

<div class="hero-transit relative w-full">
  <div
    class="grid grid-cols-1 lg:grid-cols-[1fr_auto_1fr] gap-3 sm:gap-4 items-stretch"
    aria-label="Demo 到生产 的转换通道"
  >
    <!-- ─── LEFT: DEMO terminal panel ─────────────────────────────────── -->
    <div
      class="demo-panel relative overflow-hidden rounded-[6px] border"
      style="background: var(--color-dark); border-color: var(--color-border); min-height: 220px;"
    >
      <!-- traffic-light chrome -->
      <div class="flex items-center gap-1.5 px-3 py-2 border-b" style="border-color: var(--color-border);">
        <span class="block w-2 h-2 rounded-[2px]" style="background: rgba(255,255,255,0.18);"></span>
        <span class="block w-2 h-2 rounded-[2px]" style="background: rgba(255,255,255,0.18);"></span>
        <span class="block w-2 h-2 rounded-[2px]" style="background: rgba(255,255,255,0.18);"></span>
        <span class="ml-2 font-mono text-[0.65rem] uppercase tracking-wider" style="color: rgba(255,255,255,0.42);">~/demo · local</span>
      </div>
      <!-- terminal body -->
      <div class="px-4 py-3 font-mono text-[0.78rem] sm:text-[0.85rem] leading-[1.7]" style="color: rgba(255,255,255,0.78);">
        <div class="flex items-start gap-2">
          <span style="color: var(--color-accent);">$</span>
          <span>./run --mode=demo</span>
        </div>
        <div class="opacity-70">› starting local agent...</div>
        <div class="opacity-70">› loaded 14 tools, 0 traces</div>
        <div class="flex items-start gap-2">
          <span style="color: var(--color-accent);">›</span>
          <span>reply: “Sure, I can do that.”</span>
        </div>
        <div class="mt-1" style="color: var(--color-accent);">⚠ it works on my machine</div>
        <div class="opacity-40">› no eval · no logs · no users</div>
        <div class="mt-2 flex items-start gap-2">
          <span class="inline-block w-1.5 h-3.5 chat-cursor-blink" style="background: var(--color-accent); margin-top: 0.2rem;"></span>
          <span class="opacity-40">_</span>
        </div>
      </div>
      <!-- corner label -->
      <div
        class="absolute top-2 right-2 font-mono text-[0.6rem] uppercase tracking-[0.18em] px-1.5 py-0.5 rounded-[3px]"
        style="color: var(--color-accent); background: rgba(13,148,136,0.10);"
      >
        demo
      </div>
    </div>

    <!-- ─── CENTER: TRANSIT (orb + arrows) ────────────────────────────── -->
    <div class="transit-panel relative flex items-center justify-center py-2 lg:py-0 lg:px-2" aria-hidden="true">
      <!-- horizontal arrows on lg+; vertical on mobile -->
      <div class="hidden lg:block absolute left-0 right-0 top-1/2 -translate-y-1/2 pointer-events-none">
        <svg width="100%" height="14" viewBox="0 0 200 14" preserveAspectRatio="none" class="overflow-visible">
          <line x1="0" y1="7" x2="180" y2="7"
            stroke="var(--color-accent)" stroke-width="1"
            stroke-dasharray="2 4" stroke-linecap="round" opacity="0.6" />
          <polygon points="180,3 192,7 180,11" fill="var(--color-accent)" opacity="0.6" />
        </svg>
      </div>
      <div class="lg:hidden absolute top-0 bottom-0 left-1/2 -translate-x-1/2 pointer-events-none">
        <svg width="14" height="100%" viewBox="0 0 14 200" preserveAspectRatio="none" class="overflow-visible">
          <line x1="7" y1="0" x2="7" y2="180"
            stroke="var(--color-accent)" stroke-width="1"
            stroke-dasharray="2 4" stroke-linecap="round" opacity="0.6" />
          <polygon points="3,180 7,192 11,180" fill="var(--color-accent)" opacity="0.6" />
        </svg>
      </div>
      <!-- orb -->
      <div class="relative z-10 w-[180px] sm:w-[200px] lg:w-[200px]">
        <HeroOrb size={200} />
        <div
          class="absolute -bottom-3 left-1/2 -translate-x-1/2 font-mono text-[0.6rem] uppercase tracking-[0.18em] px-2 py-0.5 rounded-[3px] whitespace-nowrap"
          style="color: var(--color-accent); background: var(--color-bg); border: 1px solid var(--color-border);"
        >
          transit
        </div>
      </div>
    </div>

    <!-- ─── RIGHT: PRODUCTION dashboard panel ─────────────────────────── -->
    <div
      class="prod-panel relative overflow-hidden rounded-[6px] border"
      style="background: var(--color-bg); border-color: var(--color-border); min-height: 220px;"
    >
      <!-- header -->
      <div class="flex items-center justify-between px-3 py-2 border-b" style="border-color: var(--color-border);">
        <span class="font-mono text-[0.65rem] uppercase tracking-wider text-text-muted">PRODUCTION</span>
        <span class="flex items-center gap-1.5 font-mono text-[0.6rem] uppercase tracking-wider" style="color: var(--color-accent);">
          <span class="block w-1.5 h-1.5 rounded-[2px]" style="background: var(--color-accent); box-shadow: 0 0 8px var(--color-accent);"></span>
          live
        </span>
      </div>
      <!-- metrics grid -->
      <div class="px-4 py-3 grid grid-cols-2 gap-x-4 gap-y-3">
        <div>
          <div class="font-mono text-[0.6rem] uppercase tracking-wider text-text-faint">deploys</div>
          <div class="mt-0.5 font-mono text-base sm:text-lg text-text leading-none">12</div>
        </div>
        <div>
          <div class="font-mono text-[0.6rem] uppercase tracking-wider text-text-faint">p95</div>
          <div class="mt-0.5 font-mono text-base sm:text-lg leading-none" style="color: var(--color-accent);">2.1s</div>
        </div>
        <div>
          <div class="font-mono text-[0.6rem] uppercase tracking-wider text-text-faint">req / min</div>
          <div class="mt-0.5 font-mono text-base sm:text-lg text-text leading-none">12k</div>
        </div>
        <div>
          <div class="font-mono text-[0.6rem] uppercase tracking-wider text-text-faint">uptime</div>
          <div class="mt-0.5 font-mono text-base sm:text-lg leading-none" style="color: var(--color-accent);">99.94%</div>
        </div>
      </div>
      <!-- footer strip -->
      <div
        class="px-4 py-2 flex items-center justify-between border-t font-mono text-[0.65rem]"
        style="border-color: var(--color-border); color: var(--color-text-muted);"
      >
        <span>last deploy <span class="text-text">3h ago</span></span>
        <span>region <span class="text-text">us-east</span></span>
      </div>
      <!-- corner label -->
      <div
        class="absolute top-2 right-2 font-mono text-[0.6rem] uppercase tracking-[0.18em] px-1.5 py-0.5 rounded-[3px]"
        style="color: var(--color-accent); background: var(--color-accent-soft);"
      >
        prod
      </div>
    </div>
  </div>

  <!-- caption row beneath the pipeline -->
  <div class="mt-3 flex items-center justify-between font-mono text-[0.65rem] uppercase tracking-[0.18em] text-text-faint">
    <span>01 — demo → production</span>
    <span class="hidden sm:inline">from local to live</span>
  </div>
</div>
