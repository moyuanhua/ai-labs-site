---
interface Props {
  size?: number;
}
const { size = 360 } = Astro.props;
---

<div
  class="hero-orb relative aspect-square w-full max-w-[420px] mx-auto"
  style={`max-width: ${size}px;`}
>
  <div class="absolute inset-0 orb-mask">
    <canvas
      data-hero-orb
      class="w-full h-full block"
      aria-hidden="true"
      role="presentation"
    ></canvas>
  </div>
  <div class="absolute inset-0 rounded-full ring-1" style="ring-color: var(--color-border); box-shadow: 0 0 60px var(--color-accent-soft) inset, 0 0 1px var(--color-border);"></div>
</div>

<script is:inline>
  (() => {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function readTokens() {
      const probe = getComputedStyle(document.documentElement);
      return {
        accent: probe.getPropertyValue('--chat-accent').trim(),
        accent2: probe.getPropertyValue('--chat-accent-2').trim(),
        soft: probe.getPropertyValue('--chat-accent-soft').trim(),
        surface: probe.getPropertyValue('--color-surface-2').trim(),
      };
    }
    function hexToRgb(hex) {
      if (!hex) return null;
      const m = hex.replace('#','').match(/^([0-9a-f]{6}|[0-9a-f]{3})$/i);
      if (!m) return null;
      let h = m[1]; if (h.length===3) h = h.split('').map(c=>c+c).join('');
      const v = parseInt(h,16); return [(v>>16)&255,(v>>8)&255,v&255];
    }
    function rgba(hex, a) {
      const rgb = hexToRgb(hex); if (!rgb) return `rgba(13,148,136,${a})`;
      return `rgba(${rgb[0]},${rgb[1]},${rgb[2]},${a})`;
    }

    function initOneOrb(canvas) {
      if (!canvas || canvas.dataset.heroOrbInit === '1') return;
      canvas.dataset.heroOrbInit = '1';
      const ctx = canvas.getContext('2d');
      if (!ctx) return;
      const dpr = window.devicePixelRatio || 1;
      let w = 0, h = 0;
      let running = true;

      function resize() {
        w = canvas.clientWidth; h = canvas.clientHeight;
        if (!w || !h) return;
        canvas.width = w * dpr; canvas.height = h * dpr;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      }
      resize();

      let tokens = readTokens();

      const smq = window.matchMedia('(prefers-color-scheme: dark)');
      smq.addEventListener?.('change', () => { tokens = readTokens(); });
      new MutationObserver(() => { tokens = readTokens(); }).observe(
        document.documentElement, { attributes: true, attributeFilter: ['class','data-theme'] }
      );

      const PARTICLES = 60;
      const PATHS = [];
      for (let i = 0; i < PARTICLES; i++) {
        const ring = i % 4;
        PATHS.push({
          angle: Math.random() * Math.PI * 2,
          radiusFactor: 0.35 + ring * 0.13,
          ryFactor:    0.30 + ring * 0.11,
          rotSel: ring,
          speed: 0.004 - ring * 0.0007 + Math.random() * 0.002,
          size: 1.4 - ring * 0.18 + Math.random() * 0.5,
          opacity: 0.7 - ring * 0.12 + Math.random() * 0.15,
        });
      }
      const BANDS = [
        { radius: 0.45, ry: 0.38 },
        { radius: 0.55, ry: 0.46 },
        { radius: 0.66, ry: 0.54 },
        { radius: 0.78, ry: 0.62 },
      ];

      let time = 0;

      function draw() {
        if (!running || !w || !h) { requestAnimationFrame(draw); return;
        }
        ctx.clearRect(0, 0, w, h);
        time += 0.016;
        const cx = w / 2;
        const cy = h / 2;
        const baseR = Math.min(w, h);
        const breathe = reduce ? 1 : 1 + Math.sin(time * 0.7) * 0.04;
        const coreR = Math.max(1, baseR * 0.18 * breathe);

        const haloR = Math.max(1, baseR * 0.6);
        const halo = ctx.createRadialGradient(cx, cy, coreR, cx, cy, haloR);
        halo.addColorStop(0, rgba(tokens.accent, 0.18));
        halo.addColorStop(0.4, rgba(tokens.accent2, 0.08));
        halo.addColorStop(1, rgba(tokens.soft, 0));
        ctx.fillStyle = halo;
        ctx.beginPath(); ctx.arc(cx, cy, haloR, 0, Math.PI * 2); ctx.fill();

        ctx.globalCompositeOperation = 'lighter';
        const orbitMul = reduce ? 0.3 : 1;
        BANDS.forEach((band, i) => {
          const rot = time * (0.18 - i * 0.04) * orbitMul;
          ctx.strokeStyle = i < 2 ? rgba(tokens.accent, 0.18) : rgba(tokens.accent2, 0.14);
          ctx.lineWidth = 1;
          ctx.beginPath();
          ctx.ellipse(
            cx, cy,
            Math.max(1, baseR * band.radius * 0.5),
            Math.max(1, baseR * band.ry * 0.5),
            rot + i * 0.2, 0, Math.PI * 2
          );
          ctx.stroke();
        });

        PATHS.forEach(p => {
          p.angle += p.speed * orbitMul;
          const band = BANDS[p.rotSel];
          const rot = time * (0.18 - p.rotSel * 0.04) * orbitMul + p.rotSel * 0.2;
          const lx = Math.cos(p.angle) * Math.max(1, baseR * p.radiusFactor * 0.5);
          const ly = Math.sin(p.angle) * Math.max(1, baseR * p.ryFactor * 0.5);
          const cosR = Math.cos(rot), sinR = Math.sin(rot);
          const px = cx + lx * cosR - ly * sinR;
          const py = cy + lx * sinR + ly * cosR;
          const ta = p.angle - p.speed * orbitMul * 4;
          const tlx = Math.cos(ta) * Math.max(1, baseR * p.radiusFactor * 0.5);
          const tly = Math.sin(ta) * Math.max(1, baseR * p.ryFactor * 0.5);
          const tpx = cx + tlx * cosR - tly * sinR;
          const tpy = cy + tlx * sinR + tly * cosR;
          const c = p.rotSel < 2 ? tokens.accent : tokens.accent2;
          ctx.strokeStyle = rgba(c, p.opacity * 0.4);
          ctx.lineWidth = Math.max(0.5, p.size * 0.7);
          ctx.beginPath(); ctx.moveTo(tpx, tpy); ctx.lineTo(px, py); ctx.stroke();
          ctx.fillStyle = rgba(c, p.opacity);
          ctx.beginPath(); ctx.arc(px, py, Math.max(0.5, p.size), 0, Math.PI * 2); ctx.fill();
          ctx.fillStyle = rgba(c, p.opacity * 0.25);
          ctx.beginPath(); ctx.arc(px, py, Math.max(1, p.size * 2), 0, Math.PI * 2); ctx.fill();
        });

        ctx.globalCompositeOperation = 'source-over';
        const outer = Math.max(1, coreR * 1.25);
        const cg = ctx.createRadialGradient(cx, cy, 0, cx, cy, outer);
        cg.addColorStop(0, 'rgba(0,0,0,1)');
        cg.addColorStop(0.55, 'rgba(0,0,0,0.92)');
        cg.addColorStop(0.86, rgba(tokens.accent, 0.85));
        cg.addColorStop(1, rgba(tokens.accent, 0));
        ctx.fillStyle = cg;
        ctx.beginPath(); ctx.arc(cx, cy, outer, 0, Math.PI * 2); ctx.fill();

        ctx.fillStyle = 'rgba(0,0,0,1)';
        ctx.beginPath(); ctx.arc(cx, cy, Math.max(1, coreR * 0.78), 0, Math.PI * 2); ctx.fill();

        ctx.globalCompositeOperation = 'lighter';
        ctx.strokeStyle = rgba(tokens.accent, 0.9);
        ctx.lineWidth = 1.2;
        ctx.beginPath(); ctx.arc(cx, cy, Math.max(1, coreR), 0, Math.PI * 2); ctx.stroke();

        ctx.globalCompositeOperation = 'source-over';
        requestAnimationFrame(draw);
      }

      const io = new IntersectionObserver(entries => {
        entries.forEach(e => {
          running = e.isIntersecting;
          if (running) requestAnimationFrame(draw);
        });
      });
      io.observe(canvas);

      const ro = new ResizeObserver(resize);
      ro.observe(canvas);

      requestAnimationFrame(draw);
    }

    function initHeroOrb() {
      document.querySelectorAll('[data-hero-orb]').forEach(initOneOrb);
    }

    initHeroOrb();
    document.addEventListener('astro:page-load', initHeroOrb);
  })();
</script>
