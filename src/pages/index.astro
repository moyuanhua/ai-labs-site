---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroOrb from '../components/HeroOrb.astro';
import { getCollection } from 'astro:content';

const BASE = import.meta.env.BASE_URL;

const allPosts = (await getCollection('posts'))
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const latest = allPosts.slice(0, 3);

const badgeMap = {
  post: { label: 'post', cls: 'surface' },
  tool: { label: 'tool', cls: 'accent' },
  demo: { label: 'demo', cls: 'accent' },
};

const dateFmt = (d: Date) => d.toLocaleDateString('zh-CN', { month: 'short', day: 'numeric' });
const yearFmt = (d: Date) => d.toLocaleDateString('zh-CN', { year: 'numeric' });
---

<BaseLayout title="AI 落地工程师 · moyuanhua" description="AI FDE — 把 AI 从 demo 干到生产。教程、Agent 拆解、提效案例、可复用工具箱。" chatVariant="dock" bgIntensity="hero">
  <section class="mx-auto max-w-[1400px] px-6 sm:px-10 lg:px-16 min-h-[calc(100dvh-4rem)] py-20 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
    <div class="lg:col-span-7 xl:col-span-6">
      <p class="font-mono text-xs uppercase tracking-wider text-text-muted">AI FDE · Forward Deployed · 落地工程师</p>
      <h1 class="mt-3 font-heading text-4xl sm:text-5xl lg:text-6xl tracking-tight leading-[1.05] text-text font-medium">
        把 AI 从 <span class="font-mono text-[var(--color-accent)]">demo</span> 干到生产。
      </h1>
      <p class="mt-6 text-base sm:text-lg text-text-muted max-w-[40ch] leading-relaxed">
        SDE — Not Just a Software Development Engineer, but Someone Who Does Everything.
      </p>
      <p class="mt-3 font-mono text-sm text-text-muted">AI 能做什么 · 我用 AI 做了什么 · 我能帮你用 AI 做什么</p>
      <div class="mt-10 flex flex-wrap gap-3 items-center">
        <a
          href={`${BASE}chat`}
          class="inline-flex items-center gap-2 rounded-[6px] px-5 py-3 text-sm font-medium transition-transform active:translate-y-px"
          style="background: var(--color-accent); color: var(--color-bg);"
        >
          <i class="ph ph-chat-circle-dots" aria-hidden="true"></i>
          与 AI 对话
          <i class="ph-bold ph-arrow-right text-sm" aria-hidden="true"></i>
        </a>
        <a
          href={`${BASE}posts`}
          class="inline-flex items-center gap-2 rounded-[6px] px-5 py-3 text-sm font-medium border transition-colors"
          style="border-color: var(--color-border); color: var(--color-text);"
        >
          浏览文章
        </a>
        <a
          href={`${BASE}tools`}
          class="inline-flex items-center gap-2 rounded-[6px] px-5 py-3 text-sm font-medium border transition-colors"
          style="border-color: var(--color-border); color: var(--color-text);"
        >
          工具箱
        </a>
      </div>
    </div>

    <div class="lg:col-span-5 xl:col-span-6 flex justify-center lg:justify-end">
      <HeroOrb size={420} />
    </div>
  </section>

  {latest.length > 0 && (
    <section class="mx-auto max-w-[1400px] px-6 sm:px-10 lg:px-16 pb-24">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-border rounded-[6px] overflow-hidden border border-border">
        {latest.map((post, i) => {
          const big = i === 0;
          const badge = badgeMap[post.data.type];
          const surfaceStyle = big ? 'background: var(--color-surface);' : 'background: var(--color-bg);';
          const badgeStyle = badge.cls === 'accent'
            ? 'background: var(--color-accent-soft); color: var(--color-accent); border-color: var(--color-accent);'
            : 'background: var(--color-surface-2); color: var(--color-text-muted); border-color: var(--color-border);';
          return (
            <a
              href={`${BASE}posts/${post.id}`}
              class={`group p-6 sm:p-8 transition-colors cursor-pointer ${big ? 'md:col-span-2 md:row-span-1' : ''}`}
              style={surfaceStyle}
            >
              <div class="flex items-center gap-3 mb-4">
                <span class="text-[0.65rem] font-mono uppercase tracking-wider px-2 py-0.5 border rounded-[3px]" style={badgeStyle}>
                  {badge.label}
                </span>
                <time class="text-xs font-mono text-text-faint">{dateFmt(post.data.date)} {yearFmt(post.data.date)}</time>
              </div>
              <h2 class={`font-heading tracking-tight leading-tight text-text group-hover:text-[var(--color-accent)] transition-colors ${big ? 'text-2xl sm:text-3xl' : 'text-xl'}`}>
                {post.data.title}
              </h2>
              <p class={`mt-3 text-text-muted leading-relaxed ${big ? 'max-w-[55ch]' : 'line-clamp-3'}`}>
                {post.data.description}
              </p>
            </a>
          );
        })}
      </div>
      <div class="mt-6 flex justify-end">
        <a href={`${BASE}posts`} class="inline-flex items-center gap-1 text-sm text-text-muted hover:text-[var(--color-accent)] transition-colors font-mono">
          全部 {allPosts.length} 条 <i class="ph ph-arrow-right" aria-hidden="true"></i>
        </a>
      </div>
    </section>
  )}
</BaseLayout>