---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = (await getCollection('posts')).filter(p => !p.data.draft && p.data.type === 'tool');
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const BASE = import.meta.env.BASE_URL;
---

<BaseLayout title={`${post.data.title} · moyuanhua`} description={post.data.description}>
  <article class="scroll-reveal max-w-3xl mx-auto py-16 px-6 sm:px-10 lg:px-16 xl:px-24">
    <div class="relative bg-bg/85 backdrop-blur-md rounded-[6px] border border-border p-6 sm:p-10">
    <a
      href={`${BASE}tools`}
      class="inline-flex items-center gap-1 font-mono text-xs text-text-muted hover:text-[var(--color-accent)] transition-colors"
    >
      <i class="ph ph-arrow-left" aria-hidden="true"></i>
      返回工具箱
    </a>

    <header class="mt-8 mb-12">
      <h1 class="font-heading text-3xl sm:text-4xl font-medium text-text leading-tight tracking-tight">
        {post.data.title}
      </h1>
      <time
        datetime={post.data.date.toISOString()}
        class="font-mono text-xs text-text-faint block mt-4 uppercase tracking-wider"
      >
        {post.data.date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
      </time>
      {post.data.tags && post.data.tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5 mt-4">
          {post.data.tags.map(tag => (
            <span class="inline-flex items-center text-xs font-mono px-2 py-1 border rounded-[3px]" style="border-color: var(--color-border); color: var(--color-text-muted); background: var(--color-surface-2);">
              {tag}
            </span>
          ))}
        </div>
      )}

      {(post.data.url || post.data.github) && (
        <div class="flex gap-3 mt-8 flex-wrap">
          {post.data.url && (
            <a
              href={post.data.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-[6px] font-medium text-sm transition-colors cursor-pointer"
              style="background: var(--color-accent); color: var(--color-bg);"
            >
              访问工具
              <i class="ph-bold ph-arrow-up-right text-xs" aria-hidden="true"></i>
            </a>
          )}
          {post.data.github && (
            <a
              href={post.data.github}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-[6px] border font-medium text-sm transition-colors cursor-pointer"
              style="border-color: var(--color-border); color: var(--color-text);"
            >
              <i class="ph ph-github-logo" aria-hidden="true"></i>
              GitHub
            </a>
          )}
        </div>
      )}
    </header>

    <div class="prose-content">
      <Content />
    </div>
    </div>
  </article>
</BaseLayout>
