---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const BASE = import.meta.env.BASE_URL;
const tools = (await getCollection('posts'))
  .filter(p => !p.data.draft && p.data.type === 'tool')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const dateFmt = (d: Date) => d.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title="工具箱 · moyuanhua" description="可复用的 Prompt / MCP / Skill / 脚本，拿来即用。">

  <div class="relative bg-bg/85 backdrop-blur-md rounded-[6px] border border-border mx-auto max-w-[1400px] px-6 sm:px-10 lg:px-16 my-12 py-10">
  <section class="pt-8 pb-12">
    <h1 class="font-heading text-4xl sm:text-5xl tracking-tight text-text font-medium">工具箱</h1>
    <p class="mt-4 text-text-muted max-w-[50ch] leading-relaxed">可复用的 Prompt / MCP / Skill / 脚本，拿来即用。</p>
  </section>

  <section class="pb-24">
    {tools.length === 0 ? (
      <p class="font-mono text-sm text-text-faint py-20 text-center">暂无工具。</p>
    ) : (
      <div class="space-y-10">
        {tools.map(tool => (
          <div class="scroll-reveal">
            <a href={`${BASE}tools/${tool.id}`} class="group block">
              <div class="flex items-baseline gap-3 mb-2">
                <time class="font-mono text-xs text-text-faint uppercase tracking-wider shrink-0">
                  {dateFmt(tool.data.date)}
                </time>
              </div>
              <h2 class="font-heading text-xl sm:text-2xl tracking-tight text-text leading-snug group-hover:text-[var(--color-accent)] transition-colors">
                {tool.data.title}
              </h2>
              <p class="mt-2 text-text-muted leading-relaxed">{tool.data.description}</p>
              {tool.data.tags && tool.data.tags.length > 0 && (
                <div class="flex flex-wrap gap-1.5 mt-3">
                  {tool.data.tags.map(tag => (
                    <span class="inline-flex items-center text-xs font-mono px-2 py-1 border rounded-[3px]" style="border-color: var(--color-border); color: var(--color-text-muted); background: var(--color-surface-2);">
                      {tag}
                    </span>
                  ))}
                </div>
              )}
              {(tool.data.url || tool.data.github) && (
                <div class="flex gap-3 mt-4 flex-wrap">
                  {tool.data.url && (
                    <span class="inline-flex items-center gap-1.5 px-4 py-2 rounded-[6px] font-medium text-xs transition-colors" style="background: var(--color-accent); color: var(--color-bg);">
                      访问
                      <i class="ph-bold ph-arrow-up-right text-xs" aria-hidden="true"></i>
                    </span>
                  )}
                  {tool.data.github && (
                    <span class="inline-flex items-center gap-1.5 px-4 py-2 rounded-[6px] border font-medium text-xs transition-colors" style="border-color: var(--color-border); color: var(--color-text);">
                      <i class="ph ph-github-logo" aria-hidden="true"></i>
                      GitHub
                    </span>
                  )}
                </div>
              )}
            </a>
          </div>
        ))}
      </div>
    )}
  </section>
  </div>
</BaseLayout>
