---
import BaseLayout from '../layouts/BaseLayout.astro';
import roadmap from '../data/roadmap.json';

const typeIcon = {
  feature: 'ph ph-pulse',
  content: 'ph ph-article',
  infra:   'ph ph-stack',
};

const colStyle = {
  planned:       { label: 'planned',       dot: false },
  'in-progress': { label: 'in progress',  dot: 'pulse' },
  done:          { label: 'shipped',       dot: 'fill' },
};

const fmt = (s?: string) => s || '';
---

<BaseLayout title="路线图 · moyuanhua" description="在动、在案、已 launch">

  <div class="relative bg-token/85 backdrop-blur-md rounded-[6px] border border-border mx-auto max-w-[1400px] px-6 sm:px-10 lg:px-16 my-12 py-10">
  <section class="pt-8 pb-12">
    <h1 class="font-heading text-4xl sm:text-5xl tracking-tight text-text font-medium">路线图</h1>
    <p class="mt-4 text-text-muted max-w-[50ch] leading-relaxed">在做什么、计划做什么、已经交付什么。</p>
  </section>

  <section class="pb-24">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
      {roadmap.columns.map(col => {
        const st = colStyle[col.id] ?? colStyle['planned'];
        return (
          <div class="scroll-reveal">
            <div class="flex items-baseline justify-between pb-3 border-b" style="border-color: var(--color-border);">
              <div class="flex items-center gap-2">
                {st.dot === 'pulse' && (
                  <span class="w-1.5 h-1.5 rounded-full" style="background: var(--color-accent); animation: pulse-dot 1.5s ease-in-out infinite;"></span>
                )}
                {st.dot === 'fill' && (
                  <i class="ph ph-check-circle text-sm" style="color: var(--color-accent);" aria-hidden="true"></i>
                )}
                <span class="font-mono text-xs uppercase tracking-wider text-text-muted">{st.label}</span>
              </div>
              <span class="font-mono text-xs text-text-faint">{col.items.length}</span>
            </div>

            <ul class="mt-6 space-y-8 list-none p-0">
              {col.items.map(item => (
                <li>
                  <div class="flex items-start gap-3">
                    <i class={`${typeIcon[item.type] || typeIcon.infra} text-sm mt-0.5`} style="color: var(--color-text-faint);" aria-hidden="true"></i>
                    <div class="flex-1 min-w-0">
                      <p class="text-text font-medium leading-snug">{item.title}</p>
                      <p class="mt-1 text-sm text-text-muted leading-relaxed">{item.description}</p>
                      <p class="mt-2 font-mono text-[0.65rem] uppercase tracking-wider text-text-faint">
                        {item.eta ? `预计 ${fmt(item.eta)}` : ''}
                        {item.date ? `交付于 ${fmt(item.date)}` : ''}
                      </p>
                    </div>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        );
      })}
    </div>
  </section>
  </div>

  <style is:global>
    @keyframes pulse-dot {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.4; transform: scale(0.85); }
    }
    @media (prefers-reduced-motion: reduce) {
      [style*="pulse-dot"] { animation: none !important; }
    }
  </style>
</BaseLayout>