---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroOrb from '../components/HeroOrb.astro';
import { getCollection } from 'astro:content';
const BASE = import.meta.env.BASE_URL;

// Pull real site content so mock answers are grounded — not generic.
// Cited as [1] [2] in replies to make the placeholder feel like RAG
// rather than a fake chat demo.
const posts = (await getCollection('posts'))
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const latest = posts.slice(0, 3).map(p => ({ title: p.data.title, slug: p.id, type: p.data.type }));
const demos = posts.filter(p => p.data.type === 'demo').slice(0, 3).map(p => ({ title: p.data.title, slug: p.id }));
const cases = posts.filter(p => p.data.tags?.includes('case')).slice(0, 3).map(p => ({ title: p.data.title, slug: p.id }));

// Hand-tuned prompts each with a grounded reply template. The reply
// references a real post + a real link so it never feels empty.
const suggestions = [
  {
    q: '最近在写什么？',
    reply: '最近在写 3 篇：\n[1] {latest0}\n[2] {latest1}\n[3] {latest2}\n都偏实战 —— 拆 demo 怎么上 prod。',
    cite: 'latest',
  },
  {
    q: '有哪些可以玩的 demo？',
    reply: '站上有几个交互 demo：\n[1] {demo0}\n[2] {demo1}\n[3] {demo2}\n都是浏览器直接跑，不依赖后端。',
    cite: 'demo',
  },
  {
    q: '做过哪些 AI 落地项目？',
    reply: '案例里 3 个可看：\n[1] {case0}\n[2] {case1}\n[3] {case2}\n都是 demo → 生产的真实路径，不是 PPT。',
    cite: 'case',
  },
  {
    q: '你是怎么用 AI 干活的？',
    reply: '我的工作流：3 个 Agent 协作 —— 拆解 / 实现 / 评审。\n具体拆解写在 [1] {latest0}。\n工具箱在 /tools，都是可复用的。',
    cite: 'latest',
  },
  {
    q: '怎么联系 / 怎么合作？',
    reply: '邮箱 [hello@moyuanhua.dev](mailto:hello@moyuanhua.dev)。\n在 /about 有更详细的现在在做的事。',
    cite: 'meta',
  },
];

function fillTemplate(t: string): string {
  return t
    .replaceAll('{latest0}', latest[0]?.title ?? '—')
    .replaceAll('{latest1}', latest[1]?.title ?? '—')
    .replaceAll('{latest2}', latest[2]?.title ?? '—')
    .replaceAll('{demo0}', demos[0]?.title ?? '—')
    .replaceAll('{demo1}', demos[1]?.title ?? '—')
    .replaceAll('{demo2}', demos[2]?.title ?? '—')
    .replaceAll('{case0}', cases[0]?.title ?? '—')
    .replaceAll('{case1}', cases[1]?.title ?? '—')
    .replaceAll('{case2}', cases[2]?.title ?? '—');
}

const filled = suggestions.map(s => ({ q: s.q, reply: fillTemplate(s.reply), cite: s.cite }));

// Map each reply to a list of {n, href, label} for footnote rendering.
function citesFor(s: { cite: string; reply: string }) {
  const items: { n: number; href: string; label: string }[] = [];
  let n = 1;
  if (s.cite === 'latest') {
    for (const p of latest.slice(0, 3)) items.push({ n: n++, href: `${BASE}posts/${p.slug}`, label: p.title });
  } else if (s.cite === 'demo') {
    for (const p of demos.slice(0, 3)) items.push({ n: n++, href: `${BASE}posts/${p.slug}`, label: p.title });
  } else if (s.cite === 'case') {
    for (const p of cases.slice(0, 3)) items.push({ n: n++, href: `${BASE}posts/${p.slug}`, label: p.title });
  } else {
    items.push({ n: 1, href: `${BASE}about`, label: '关于页' });
  }
  return items;
}
const enriched = filled.map(s => ({ ...s, cites: citesFor(s) }));
---

<BaseLayout title="对话 · moyuanhua" description="和 moyuanhua 的 AI 聊这个站上的内容" chatVariant="none" bgIntensity="ambient" hideNav hideFooter>
  <div class="chat-shell relative h-screen w-full flex flex-col bg-bg text-text overflow-hidden">
    <!-- minimal header -->
    <header class="shrink-0 h-12 px-4 sm:px-6 flex items-center justify-between border-b border-border bg-bg/85 backdrop-blur-md">
      <a href={BASE} class="inline-flex items-center gap-2 text-sm font-heading font-semibold tracking-tight hover:text-accent transition-colors">
        <span aria-hidden="true">←</span>
        <span>moyuanhua</span>
      </a>
      <div class="flex items-center gap-2 text-[0.65rem] font-mono uppercase tracking-wider text-text-muted">
        <span class="w-1.5 h-1.5 rounded-[2px]" style="background: var(--color-accent); box-shadow: 0 0 8px var(--color-accent);"></span>
        <span>ai 待机 · 待接入</span>
      </div>
    </header>

    <!-- stage: orb + greeting + input + prompts -->
    <main class="flex-1 min-h-0 overflow-y-auto" data-chat-stage>
      <section class="mx-auto max-w-3xl px-4 sm:px-6 pt-10 sm:pt-16 pb-8 flex flex-col items-center text-center">
        <div class="w-[200px] sm:w-[280px]">
          <HeroOrb size={280} />
        </div>
        <p class="mt-6 font-heading text-lg sm:text-2xl font-medium text-text">
          你好，我是 moyuanhua 的 AI
        </p>
        <p class="mt-2 text-xs sm:text-base text-text-muted max-w-[260px] sm:max-w-md mx-auto leading-relaxed">
          问我的工作、demo、写作。我读过这个站上的全部内容。
        </p>
      </section>

      <section class="mx-auto max-w-2xl px-4 sm:px-6 pb-8 sm:pb-12">
        <!-- input -->
        <div class="relative">
          <input
            data-chat-input
            type="text"
            placeholder="随便问点什么…"
            aria-label="输入问题"
            class="w-full bg-surface border border-border rounded-[6px] px-4 py-3.5 pr-12 text-sm sm:text-base font-body focus:outline-none focus:border-accent transition-colors"
            style="background: var(--color-surface);"
          />
          <button
            data-chat-send
            type="button"
            class="absolute right-2 top-1/2 -translate-y-1/2 w-9 h-9 inline-flex items-center justify-center rounded-[6px] transition-colors cursor-pointer"
            style="background: var(--color-accent); color: var(--color-bg);"
            aria-label="发送"
          >
            <i class="ph-bold ph-arrow-up text-base" aria-hidden="true"></i>
          </button>
        </div>

        <!-- prompt chips -->
        <div class="mt-4 flex flex-wrap gap-2 justify-center max-w-full">
          {enriched.map(s => (
            <button
              data-suggestion
              data-q={s.q}
              type="button"
              class="text-xs sm:text-sm font-body px-3 py-1.5 rounded-[3px] border transition-colors cursor-pointer whitespace-nowrap"
              style="border-color: var(--color-text-faint); color: var(--color-text);"
            >
              {s.q}
            </button>
          ))}
        </div>

        <!-- conversation appears here after first send -->
        <div data-chat-thread class="mt-8 sm:mt-10 space-y-5"></div>
      </section>
    </main>
  </div>

  <script id="chat-data" type="application/json" set:html={JSON.stringify(enriched)}></script>

  <script is:inline>
    (() => {
      const STORAGE_KEY = 'moyuanhua-chat-history-v2';
      const dataEl = document.getElementById('chat-data');
      if (!dataEl) return;
      let enriched = [];
      try { enriched = JSON.parse(dataEl.textContent || '[]'); } catch { enriched = []; }

      function getHistory() {
        try { return JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]'); }
        catch { return []; }
      }
      function saveHistory(h) { localStorage.setItem(STORAGE_KEY, JSON.stringify(h)); }

      function renderReplyWithCitations(text, cites) {
        // Convert "[1] foo\n[2] bar" into a list of two lines and a footnote row.
        // Strategy: split off the leading "headline" line (no '[n]') and the
        // remaining [n] lines, render them as bullets, then a footnote row.
        const wrap = document.createElement('div');
        wrap.className = 'rounded-[6px] border p-4 chat-bubble-enter';
        wrap.style.background = 'var(--color-surface)';
        wrap.style.borderColor = 'var(--color-border)';

        const lines = text.split('\n');
        const head = [];
        const citesText = [];
        for (const line of lines) {
          if (/^\[\d+\]/.test(line)) citesText.push(line);
          else head.push(line);
        }

        if (head.length) {
          const p = document.createElement('div');
          p.className = 'text-sm sm:text-base font-body leading-relaxed text-text whitespace-pre-line';
          p.textContent = head.join('\n');
          wrap.appendChild(p);
        }
        if (citesText.length) {
          const ul = document.createElement('ul');
          ul.className = 'mt-2 space-y-1 list-none';
          for (const line of citesText) {
            const li = document.createElement('li');
            li.className = 'text-sm font-body text-text-muted flex items-start gap-2';
            const m = line.match(/^\[(\d+)\]\s*(.+)$/);
            if (m) {
              const num = m[1];
              const label = m[2].trim();
              const cite = (cites || []).find(c => String(c.n) === num);
              if (cite) {
                const a = document.createElement('a');
                a.href = cite.href;
                a.className = 'hover:text-accent transition-colors underline decoration-text-faint underline-offset-2';
                a.style.color = 'var(--color-text)';
                a.textContent = `[${num}] ${label}`;
                li.appendChild(a);
              } else {
                li.textContent = line;
              }
            } else {
              li.textContent = line;
            }
            ul.appendChild(li);
          }
          wrap.appendChild(ul);
        }

        // footnote row mapping [n] → real link, with the *real* link label
        if (cites && cites.length) {
          const foot = document.createElement('div');
          foot.className = 'mt-3 pt-3 border-t flex flex-wrap gap-3 text-[0.7rem] font-mono uppercase tracking-wider text-text-faint';
          foot.style.borderColor = 'var(--color-border)';
          for (const c of cites) {
            const a = document.createElement('a');
            a.href = c.href;
            a.className = 'hover:text-accent transition-colors';
            a.textContent = `[${c.n}] → ${c.label}`;
            foot.appendChild(a);
          }
          wrap.appendChild(foot);
        }
        return wrap;
      }

      function renderUserBubble(text) {
        const div = document.createElement('div');
        div.className = 'rounded-[6px] p-3 text-sm sm:text-base font-body ml-auto max-w-[85%] chat-bubble-enter';
        div.style.background = 'var(--color-accent)';
        div.style.color = 'var(--color-bg)';
        div.textContent = text;
        return div;
      }

      function renderTyping() {
        const div = document.createElement('div');
        div.className = 'rounded-[6px] border p-3 inline-flex gap-1';
        div.style.background = 'var(--color-surface)';
        div.style.borderColor = 'var(--color-border)';
        div.innerHTML = '<span class="typing-dot"></span><span class="typing-dot"></span><span class="typing-dot"></span>';
        return div;
      }

      function bestMatch(q) {
        // simple keyword match against suggestion questions
        const ql = q.toLowerCase();
        let best = enriched[0];
        let bestScore = 0;
        for (const s of enriched) {
          const sl = s.q.toLowerCase();
          let score = 0;
          for (const w of sl.split(/\s+/)) {
            if (w.length > 1 && ql.includes(w)) score++;
          }
          if (score > bestScore) { best = s; bestScore = score; }
        }
        return best;
      }

      function appendExchange(q, reply, cites) {
        const thread = document.querySelector('[data-chat-thread]');
        if (!thread) return;
        thread.appendChild(renderUserBubble(q));
        const typing = renderTyping();
        thread.appendChild(typing);
        thread.scrollIntoView({ behavior: 'smooth', block: 'end' });
        window.__MOYUANHUA_orbState = 'replying';
        setTimeout(() => {
          typing.remove();
          thread.appendChild(renderReplyWithCitations(reply, cites));
          window.__MOYUANHUA_orbState = 'idle';
          thread.scrollIntoView({ behavior: 'smooth', block: 'end' });
        }, 700);
      }

      function init() {
        const input = document.querySelector('[data-chat-input]');
        const sendBtn = document.querySelector('[data-chat-send]');
        const thread = document.querySelector('[data-chat-thread]');
        if (!input || !sendBtn || !thread) return;

        // restore prior conversation
        const history = getHistory();
        for (const h of history) {
          if (h.role === 'user') thread.appendChild(renderUserBubble(h.text));
          else {
            const s = enriched.find(x => x.q === h.matchQ);
            thread.appendChild(renderReplyWithCitations(h.text, s ? s.cites : []));
          }
        }

        function submit(text) {
          const q = (text || '').trim();
          if (!q) return;
          const matched = bestMatch(q);
          appendExchange(q, matched.reply, matched.cites);
          const h = getHistory();
          h.push({ role: 'user', text: q, ts: Date.now() });
          h.push({ role: 'ai', text: matched.reply, matchQ: matched.q, ts: Date.now() });
          saveHistory(h);
          input.value = '';
        }

        sendBtn.addEventListener('click', () => submit(input.value));
        input.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); submit(input.value); }
        });

        document.querySelectorAll('[data-suggestion]').forEach(btn => {
          btn.addEventListener('click', () => {
            const q = btn.getAttribute('data-q') || '';
            submit(q);
          });
        });
      }

      init();
      document.addEventListener('astro:page-load', init);
    })();
  </script>
</BaseLayout>
