---
import BaseLayout from '../layouts/BaseLayout.astro';
import ChatLayer from '../components/ChatLayer.astro';
const BASE = import.meta.env.BASE_URL;

const suggestions = [
  '最近写了什么？',
  '有哪些 demo？',
  '在做的产品进展',
  '技术栈是什么',
];
---

<BaseLayout title="对话 · moyuanhua" description="和 moyuanhua 的 AI 聊天" chatVariant="hero" hideNav hideFooter>
  <div class="chat-shell h-screen w-full flex flex-col bg-bg text-text overflow-hidden">
    <header class="shrink-0 h-12 px-4 sm:px-6 flex items-center justify-between bg-bg/85 backdrop-blur-md border-b border-border">
      <a href={BASE} class="inline-flex items-center gap-2 text-sm font-heading font-semibold tracking-tight hover:text-accent transition-colors">
        <span aria-hidden="true">←</span>
        <span>moyuanhua</span>
      </a>
      <div class="flex items-center gap-2 text-xs text-text-muted">
        <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
        <span class="font-mono uppercase tracking-wider">在案</span>
      </div>
    </header>

    <div class="flex-1 min-h-0 flex">
      <aside class="hidden lg:flex flex-col w-64 shrink-0 border-r border-border bg-surface">
        <div class="p-4 border-b border-border">
          <button
            data-new-chat
            type="button"
            class="w-full rounded-[6px] px-3 py-2 text-sm font-medium border border-border hover:border-accent hover:text-accent transition-colors cursor-pointer"
          >
            ＋ 新对话
          </button>
        </div>
        <div class="flex-1 overflow-y-auto p-4 space-y-6">
          <div>
            <div class="text-[0.65rem] font-mono uppercase tracking-wider text-text-faint mb-2">对话</div>
            <div class="rounded-[6px] px-3 py-2 text-sm bg-bg border border-border">
              <div class="font-medium truncate">今日对话</div>
              <div data-conv-count class="text-xs text-text-faint mt-0.5">本地保存</div>
            </div>
          </div>
          <div>
            <div class="text-[0.65rem] font-mono uppercase tracking-wider text-text-faint mb-2">试试</div>
            <div class="flex flex-col gap-2">
              {suggestions.map(s => (
                <button
                  data-suggestion={s}
                  type="button"
                  class="text-left text-sm px-3 py-2 rounded-[6px] border border-border hover:border-accent hover:text-accent transition-colors cursor-pointer"
                >
                  {s}
                </button>
              ))}
            </div>
          </div>
        </div>
        <div class="p-4 border-t border-border text-[0.65rem] font-mono text-text-faint">
          history · localStorage
        </div>
      </aside>

      <main class="flex-1 min-w-0 relative">
        <ChatLayer variant="hero" />
      </main>
    </div>
  </div>

  <script is:inline>
    function initChatShell() {
      const newChatBtn = document.querySelector('[data-new-chat]');
      if (newChatBtn) {
        newChatBtn.addEventListener('click', () => {
          try { localStorage.removeItem('moyuanhua-chat-history'); } catch {}
          location.reload();
        });
      }

      document.querySelectorAll('[data-suggestion]').forEach(btn => {
        btn.addEventListener('click', () => {
          const text = btn.getAttribute('data-suggestion');
          if (!text) return;
          const input = document.querySelector('[data-chat-input]');
          if (input) {
            input.value = text;
            input.dispatchEvent(new Event('input', { bubbles: true }));
            input.focus();
          }
        });
      });

      const countEl = document.querySelector('[data-conv-count]');
      if (countEl) {
        try {
          const h = JSON.parse(localStorage.getItem('moyuanhua-chat-history') || '[]');
          countEl.textContent = h.length > 0 ? `${h.length} 条消息` : '本地保存';
        } catch {}
      }
    }
    initChatShell();
    document.addEventListener('astro:page-load', initChatShell);
  </script>
</BaseLayout>
