---
import BaseLayout from '../layouts/BaseLayout.astro';
import about from '../data/about.json';

type AboutItem = string | { label: string; url: string };
type AboutSection = { title: string; items: AboutItem[]; isContact?: boolean };

const sections: AboutSection[] = [
  { title: '现在',     items: about.now },
  { title: '最近的项目', items: about.projects },
  { title: '技能与工具', items: about.skills },
  { title: '联系',     items: about.contact, isContact: true },
];

const isEmpty = (s: AboutSection) => s.items.length === 0;
const isContactItem = (item: AboutItem): item is { label: string; url: string } =>
  typeof item === 'object' && item !== null && 'label' in item && 'url' in item;
const allEmpty = sections.every(isEmpty);
---

<BaseLayout title="关于 · moyuanhua" description="AI FDE — AI 落地工程师，把 AI 从 demo 干到生产">

  <article class="mx-auto max-w-[760px] px-6 sm:px-10 py-20">
    <div class="relative bg-bg/85 backdrop-blur-md rounded-[6px] border border-border p-6 sm:p-10">
    <h1 class="font-heading text-4xl sm:text-5xl tracking-tight text-text font-medium mb-4">关于</h1>
    <div class="prose-content mb-10">
      <p class="text-text-muted leading-relaxed">AI FDE（AI Forward Deployed Engineer / AI 落地工程师）— 把 AI 从 demo 干到生产。</p>
      <p class="text-text-muted leading-relaxed">SDE = Not Just a Software Development Engineer, but Someone Who Does Everything.</p>
    </div>

    {allEmpty && (
      <div class="space-y-8 py-12 border-y" style="border-color: var(--color-border);">
        <p class="text-text-muted leading-relaxed max-w-[55ch]">内容待填。关于页与作品同体：_本项目_即简介本身。</p>
        <pre class="font-mono text-xs text-text-faint p-4 rounded-[6px] overflow-x-auto" style="background: var(--color-surface); border: 1px solid var(--color-border);">src/data/about.json</pre>
        <p class="text-sm text-text-muted">在 <code class="font-mono text-xs px-1.5 py-0.5 rounded-[3px]" style="background: var(--color-surface-2); border: 1px solid var(--color-border);">now</code> / <code class="font-mono text-xs px-1.5 py-0.5 rounded-[3px]" style="background: var(--color-surface-2); border: 1px solid var(--color-border);">projects</code> / <code class="font-mono text-xs px-1.5 py-0.5 rounded-[3px]" style="background: var(--color-surface-2); border: 1px solid var(--color-border);">skills</code> / <code class="font-mono text-xs px-1.5 py-0.5 rounded-[3px]" style="background: var(--color-surface-2); border: 1px solid var(--color-border);">contact</code> 数组里填字符串或对象即可。</p>
      </div>
    )}

    <div class="space-y-16">
      {sections.map(section => (
        <section class="scroll-reveal {isEmpty(section) ? 'opacity-60' : ''}">
          <h2 class="font-heading text-xl text-text font-medium mb-5">{section.title}</h2>
          {isEmpty(section) ? (
            <p class="font-mono text-xs text-text-faint">待补</p>
          ) : section.isContact ? (
            <ul class="space-y-3 list-none p-0">
              {section.items.map(item => {
                if (!isContactItem(item)) return null;
                return (
                  <li class="flex flex-wrap items-baseline gap-x-3">
                    <span class="font-mono text-xs uppercase tracking-wider text-text-faint">{item.label}</span>
                    <a
                      href={item.url}
                      class="text-text hover:text-[var(--color-accent)] transition-colors break-all"
                      target="_blank"
                      rel="noopener noreferrer"
                    >{item.url}</a>
                  </li>
                );
              })}
            </ul>
          ) : (
            <ul class="space-y-3 list-none p-0">
              {section.items.map(item => (
                <li class="text-text-muted leading-relaxed pl-4 border-l" style="border-color: var(--color-border);">{String(item)}</li>
              ))}
            </ul>
          )}
        </section>
      ))}
    </div>
    </div>
  </article>
</BaseLayout>