---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const BASE = import.meta.env.BASE_URL;
const cases = (await getCollection('posts'))
  .filter(p => !p.data.draft && p.data.type === 'post' && (p.data.tags || []).includes('case'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const dateFmt = (d: Date) => d.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title="案例 · moyuanhua" description="把 AI 从 demo 干到生产——真实项目交付案例。">

  <div class="relative bg-token/85 backdrop-blur-md rounded-[6px] border border-border mx-auto max-w-[1400px] px-6 sm:px-10 lg:px-16 my-12 py-10">
  <section class="pt-8 pb-12">
    <h1 class="font-heading text-4xl sm:text-5xl tracking-tight text-text font-medium">案例</h1>
    <p class="mt-4 text-text-muted max-w-[50ch] leading-relaxed">把 AI 从 demo 干到生产——真实项目交付案例。</p>
  </section>

  <section class="pb-24">
    {cases.length === 0 ? (
      <p class="font-mono text-sm text-text-faint py-20 text-center">暂无案例。</p>
    ) : (
      <div class="space-y-10">
        {cases.map(item => (
          <div class="scroll-reveal">
            <a href={`${BASE}posts/${item.id}`} class="group block">
              <div class="flex items-baseline gap-3 mb-2">
                <time class="font-mono text-xs text-text-faint uppercase tracking-wider shrink-0">
                  {dateFmt(item.data.date)}
                </time>
              </div>
              <h2 class="font-heading text-xl sm:text-2xl tracking-tight text-text leading-snug group-hover:text-[var(--color-accent)] transition-colors">
                {item.data.title}
              </h2>
              <p class="mt-2 text-text-muted leading-relaxed">{item.data.description}</p>
              {item.data.tags && item.data.tags.length > 0 && (
                <div class="flex flex-wrap gap-1.5 mt-3">
                  {item.data.tags.map(tag => (
                    <span class="inline-flex items-center text-xs font-mono px-2 py-1 border rounded-[3px]" style="border-color: var(--color-border); color: var(--color-text-muted); background: var(--color-surface-2);">
                      {tag}
                    </span>
                  ))}
                </div>
              )}
            </a>
          </div>
        ))}
      </div>
    )}
  </section>
  </div>
</BaseLayout>
