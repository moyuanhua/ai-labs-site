---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const BASE = import.meta.env.BASE_URL;
const posts = (await getCollection('posts'))
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const typeBadge = {
  post: { label: 'post', accent: false },
  tool: { label: 'tool', accent: true },
  demo: { label: 'demo', accent: true },
};

const yearGroups: Record<string, typeof posts> = {};
for (const p of posts) {
  const y = String(p.data.date.getFullYear());
  if (!yearGroups[y]) yearGroups[y] = [];
  yearGroups[y].push(p);
}
const years = Object.keys(yearGroups).sort((a, b) => Number(b) - Number(a));

const dateFmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', day: '2-digit' });
---

<BaseLayout title="文章 · moyuanhua" description="教程、Agent 拆解、提效案例、观点">

  <div class="relative bg-token/85 backdrop-blur-md rounded-[6px] border border-border mx-auto max-w-[1400px] px-6 sm:px-10 lg:px-16 my-12 py-10">
  <section class="pt-8 pb-12">
    <h1 class="font-heading text-4xl sm:text-5xl tracking-tight text-text font-medium">文章</h1>
    <p class="mt-4 text-text-muted max-w-[50ch] leading-relaxed">教程、Agent 拆解、提效案例、观点，按时间倒序。</p>
  </section>

  <div class="flex flex-wrap gap-2 mb-8" id="tag-filter">
    <button data-tag="all" class="tag-chip tag-chip-active rounded-[6px] px-3 py-1.5 text-xs font-mono uppercase tracking-wider border transition-colors cursor-pointer" style="border-color: var(--color-accent); color: var(--color-accent); background: var(--color-accent-soft);">全部</button>
    <button data-tag="tutorial" class="tag-chip rounded-[6px] px-3 py-1.5 text-xs font-mono uppercase tracking-wider border transition-colors cursor-pointer" style="border-color: var(--color-border); color: var(--color-text-muted); background: transparent;">tutorial</button>
    <button data-tag="teardown" class="tag-chip rounded-[6px] px-3 py-1.5 text-xs font-mono uppercase tracking-wider border transition-colors cursor-pointer" style="border-color: var(--color-border); color: var(--color-text-muted); background: transparent;">teardown</button>
    <button data-tag="case" class="tag-chip rounded-[6px] px-3 py-1.5 text-xs font-mono uppercase tracking-wider border transition-colors cursor-pointer" style="border-color: var(--color-border); color: var(--color-text-muted); background: transparent;">case</button>
    <button data-tag="note" class="tag-chip rounded-[6px] px-3 py-1.5 text-xs font-mono uppercase tracking-wider border transition-colors cursor-pointer" style="border-color: var(--color-border); color: var(--color-text-muted); background: transparent;">note</button>
  </div>

  <section class="pb-24">
    {posts.length === 0 ? (
      <p class="font-mono text-sm text-text-faint py-20 text-center">尚无内容。</p>
    ) : (
      <div class="space-y-16">
        {years.map(year => (
          <div class="scroll-reveal" data-year-group>
            <div class="flex items-baseline gap-4 mb-6 border-b pb-2" style="border-color: var(--color-border);">
              <span class="font-mono text-xs text-text-faint">{year}</span>
              <span class="font-mono text-[0.65rem] text-text-faint uppercase tracking-wider">{yearGroups[year].length} 条</span>
            </div>
            <div class="space-y-10">
              {yearGroups[year].map(post => {
                const badge = typeBadge[post.data.type];
                const badgeStyle = badge.accent
                  ? 'background: var(--color-accent-soft); color: var(--color-accent); border-color: var(--color-accent);'
                  : 'background: var(--color-surface-2); color: var(--color-text-muted); border-color: var(--color-border);';
                return (
                  <a href={`${BASE}posts/${post.id}`} class="group grid grid-cols-12 gap-3 sm:gap-6 items-baseline cursor-pointer" data-post-item data-type={post.data.type} data-tags={(post.data.tags || []).join(',')}>
                    <time class="col-span-3 sm:col-span-2 font-mono text-xs text-text-faint uppercase tracking-wider">
                      {dateFmt(post.data.date)}
                    </time>
                    <div class="col-span-9 sm:col-span-2 flex items-center">
                      <span class="text-[0.65rem] font-mono uppercase tracking-wider px-2 py-0.5 border rounded-[3px]" style={badgeStyle}>
                        {badge.label}
                      </span>
                    </div>
                    <div class="col-span-12 sm:col-span-7">
                      <h2 class="font-heading text-xl sm:text-2xl tracking-tight text-text leading-snug group-hover:text-[var(--color-accent)] transition-colors">
                        {post.data.title}
                      </h2>
                      <p class="mt-2 text-text-muted leading-relaxed sm:pr-8">{post.data.description}</p>
                    </div>
                  </a>
                );
              })}
            </div>
          </div>
        ))}
      </div>
    )}
  </section>
  </div>

  <script is:inline>
    (() => {
      const init = () => {
        const filter = document.getElementById('tag-filter');
        if (!filter) return;
        const chips = filter.querySelectorAll('[data-tag]');
        const items = document.querySelectorAll('[data-post-item]');
        const yearSections = document.querySelectorAll('[data-year-group]');

        const setActive = (activeTag) => {
          chips.forEach(c => {
            const isActive = c.dataset.tag === activeTag;
            if (isActive) {
              c.classList.add('tag-chip-active');
              c.style.borderColor = 'var(--color-accent)';
              c.style.color = 'var(--color-accent)';
              c.style.background = 'var(--color-accent-soft)';
            } else {
              c.classList.remove('tag-chip-active');
              c.style.borderColor = 'var(--color-border)';
              c.style.color = 'var(--color-text-muted)';
              c.style.background = 'transparent';
            }
          });
        };

        const applyFilter = (tag) => {
          setActive(tag);
          items.forEach(item => {
            const type = item.dataset.type;
            const tags = item.dataset.tags ? item.dataset.tags.split(',') : [];
            if (tag === 'all') {
              item.style.display = '';
            } else if (type === 'post' && tags.includes(tag)) {
              item.style.display = '';
            } else {
              item.style.display = 'none';
            }
          });
          yearSections.forEach(section => {
            const visible = section.querySelectorAll('[data-post-item]');
            let hasVisible = false;
            visible.forEach(v => { if (v.style.display !== 'none') hasVisible = true; });
            section.style.display = hasVisible ? '' : 'none';
          });
        };

        chips.forEach(chip => {
          chip.addEventListener('click', () => applyFilter(chip.dataset.tag));
        });
      };
      init();
      document.addEventListener('astro:page-load', init);
    })();
  </script>
</BaseLayout>