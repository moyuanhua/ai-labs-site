---
import { ClientRouter } from 'astro:transitions';
import ChatLayer from '../components/ChatLayer.astro';
import SiteBackground from '../components/SiteBackground.astro';
import '@fontsource/geist/400.css';
import '@fontsource/geist/500.css';
import '@fontsource/geist/600.css';
import '@fontsource/geist/700.css';
import '@fontsource/geist-mono/400.css';
import '@phosphor-icons/web/regular';
import '@phosphor-icons/web/bold';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  chatVariant?: 'hero' | 'dock';
  bgIntensity?: 'ambient' | 'hero' | 'none';
  hideNav?: boolean;
  hideFooter?: boolean;
}
const { title, description = 'AI 落地工程师 · 把 AI 从 demo 干到生产', chatVariant = 'dock', bgIntensity = 'none', hideNav = false, hideFooter = false } = Astro.props;
const BASE = import.meta.env.BASE_URL;
const navLinks = [
  { href: `${BASE}`,       label: '首页' },
  { href: `${BASE}posts`,  label: '文章' },
  { href: `${BASE}cases`,  label: '案例' },
  { href: `${BASE}tools`,  label: '工具箱' },
  { href: `${BASE}about`,  label: '关于' },
];
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
// Compare nav hrefs against the current path. With `BASE=/ai-labs-site/`,
// `Astro.url.pathname` already INCLUDES the base (verified via build
// logs: `/posts` page emits `pathname=/ai-labs-site/posts`). So href
// and currentPath live in the same coordinate space. The only edge
// case is the home link, whose href is just the base — that string
// is a strict prefix of every other page's path, so a naive
// `startsWith` would mark home as active everywhere. We special-case
// the home to only match when we are exactly on the base.
const baseNoSlash = BASE.endsWith('/') ? BASE.slice(0, -1) : BASE;
const isHome = (href: string) => {
  const norm = href.endsWith('/') && href.length > 1 ? href.slice(0, -1) : href;
  return norm === baseNoSlash;
};
const isOther = (href: string) => {
  const norm = href.endsWith('/') && href.length > 1 ? href.slice(0, -1) : href;
  return currentPath === norm || currentPath.startsWith(norm + '/');
};
const isActive = (href: string) => isHome(href)
  ? (currentPath === baseNoSlash || currentPath === '/ai-labs-site' || currentPath === '' || currentPath === '/')
  : isOther(href);
const year = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="generator" content={Astro.generator} />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href={`${BASE}favicon.svg`} sizes="any" />
  <ClientRouter />
  <script is:inline>
    () => {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce || !('IntersectionObserver' in window)) return;
      import('lenis').then(({ default: Lenis }) => {
        const lenis = new Lenis({ duration: 1.2, easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)) });
        const raf = (t: number) => { lenis.raf(t); requestAnimationFrame(raf); };
        requestAnimationFrame(raf);
      });
    })();
  </script>
  <script is:inline>
    (() => {
      const init = () => {
        const els = document.querySelectorAll('.scroll-reveal:not(.is-visible)');
        if (!('IntersectionObserver' in window)) {
          els.forEach(el => el.classList.add('is-visible'));
          return;
        }
        const obs = new IntersectionObserver((entries) => {
          entries.forEach(e => {
            if (e.isIntersecting) { e.target.classList.add('is-visible'); obs.unobserve(e.target); }
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -60px 0px' });
        els.forEach(el => obs.observe(el));
      };
      init();
      document.addEventListener('astro:page-load', init);
    })();
  </script>
</head>
<body class="bg-[var(--color-bg)] text-text min-h-screen flex flex-col antialiased font-body overflow-x-hidden relative">
  {bgIntensity !== 'none' && <SiteBackground intensity={bgIntensity} />}
  {!hideNav && (
    <header class="sticky top-0 z-50 bg-token/85 backdrop-blur-md border-b border-border">
      <nav class="mx-auto max-w-[1400px] px-6 sm:px-10 lg:px-16 h-16 flex items-center justify-between gap-4">
        <a
          href={BASE}
          class="font-heading text-lg font-semibold tracking-tight text-text hover:text-accent transition-colors duration-200"
        >
          moyuanhua
        </a>
        <ul class="flex items-center gap-5">
          {navLinks.map(link => (
            <li>
              <a
                href={link.href}
                aria-current={isActive(link.href) ? 'page' : undefined}
                class={`relative text-sm font-medium transition-colors duration-200 ${
                  isActive(link.href)
                    ? 'text-text'
                    : 'text-text-muted hover:text-text'
                }`}
              >
                {link.label}
                {!link.soon && isActive(link.href) && (
                  <span class="absolute -bottom-[18px] left-0 right-0 h-[2px] bg-accent" aria-hidden="true"></span>
                )}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>
  )}

  <main class="flex-1 w-full relative z-10">
    <slot />
  </main>

  {!hideFooter && (
    <footer class="border-t border-border mt-20 relative z-10">
      <div class="mx-auto max-w-[1400px] px-6 sm:px-10 lg:px-16 py-10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <p class="font-mono text-xs text-text-muted">© {year} moyuanhua</p>
        <a
          href={`mailto:hello@moyuanhua.dev`}
          class="text-xs font-mono text-text-muted hover:text-accent transition-colors"
        >hello@moyuanhua.dev</a>
      </div>
    </footer>
  )}

  {chatVariant === 'dock' && <ChatLayer variant="dock" />}
</body>
</html>
